{
  "name": "seolin-safecheck-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Seolin SafeCheck MVP API backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test",
    "account:create": "node src/scripts/createAccount.js",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/db/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/db/seed.sql",
    "db:reset:dev": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/db/schema.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/db/seed.sql"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "pg": "^8.13.1",
    "solapi": "^6.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
